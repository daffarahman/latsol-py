# Copy to `.env` and adjust as needed.
# The app loads `.env` automatically (existing environment variables win).

# --- Ollama / OpenAI-compatible endpoint ---
LATSOL_BASE_URL=http://localhost:11434/v1
LATSOL_API_KEY=ollama
LATSOL_MODEL=llama3.1:8b

# --- Generation parameters ---
LATSOL_TEMPERATURE=0.4
LATSOL_MAX_TOKENS=4096

# --- Upstream client behaviour ---
# Seconds to wait for the model before giving up, and how many times to retry.
LATSOL_REQUEST_TIMEOUT=30
LATSOL_MAX_RETRIES=1

# --- Server protections ---
# Max number of simultaneous generations; extra requests get HTTP 503.
LATSOL_MAX_CONCURRENCY=4
# If set, /quiz requires `X-API-Key: <value>`. Leave blank to disable auth.
LATSOL_SERVICE_API_KEY=
# Set to false in production to hide /docs and /openapi.json.
LATSOL_DOCS_ENABLED=true
